# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ai_shopping_copilot_scraper

# Database Configuration
POSTGRES_USER=scraper_user
POSTGRES_PASSWORD=scraper_password
POSTGRES_DB=scraper_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scraper_user:scraper_password@localhost:5432/scraper_db

# Playwright Browser Pool
BROWSER_HEADLESS=true
BROWSER_MAX_INSTANCES=3
BROWSER_MAX_CONTEXTS_PER_BROWSER=5
BROWSER_MAX_PAGES_PER_CONTEXT=10
BROWSER_NAVIGATION_TIMEOUT_MS=30000

# Request Manager & Throttling
RATE_LIMIT_PER_MINUTE=30
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
JITTER_RANGE_MS=500
RANDOM_DELAY_MIN_MS=1000
RANDOM_DELAY_MAX_MS=3000

# Raw Storage Configuration
RAW_STORAGE_DIR=data/raw_payloads
RAW_STORAGE_MODE=filesystem # filesystem | database | both

# Worker & Queue
WORKER_CONCURRENCY=5
QUEUE_MAX_SIZE=10000

# Observability
OTEL_SERVICE_NAME=ai-shopping-scraper
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=8000
